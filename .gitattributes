# Source, documentation and PowerShell scripts use LF on every platform.
* text=auto eol=lf
*.ps1 text eol=lf

# Native Windows batch scripts require CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Retain exact bytes for archived manifests and version locks.
manifests/** -text
manifests/README.md text eol=lf
**/split_manifest.json -text
*.lock.json -text
requirements/lock.windows.txt -text

# Binary attachments must not undergo newline conversion.
*.pdf -text
