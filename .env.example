# Copy to .env locally; never commit credentials. No model is downloaded by setup.
# Keep these empty to use the project config.yaml; nonempty values override YAML.
REPRO_MODEL_NAME=
REPRO_BASE_URL=
REPRO_API_KEY=local-only
# Prefer model.local_path in config.yaml; set this ONLY for a machine-local override.
# A nonempty value overrides every YAML model path. Keep empty to use config.yaml.
# Supply a complete local directory including weights; a Hugging Face repo ID is not a path.
REPRO_MODEL_PATH=
# Optional download locations for benchmark DATA, not model weights.
HF_HOME=.cache/huggingface
HF_HUB_DISABLE_TELEMETRY=1

